{
  "info": {
    "name": "DSCF Credit API",
    "description": "Postman collection for DSCF Credit API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script (collection-level)",
          "// Token is set via {{accessToken}} environment variable"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "createDeliveryExpectedStatus",
      "value": "201"
    }
  ],
  "item": [
    {
      "name": "Api Keys",
      "item": [
        {
          "name": "List Api Keys",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for staff/admin user"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api_keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api_keys"
              ]
            },
            "description": "Lists API keys for the current tenant. Requires authenticated staff/admin user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array of api key objects', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(Array.isArray(json)).to.eql(true);",
                  "  if (json.length > 0) {",
                  "    pm.expect(json[0]).to.have.property('id');",
                  "    pm.expect(json[0]).to.have.property('name');",
                  "    pm.expect(json[0]).to.have.property('scopes');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Api Key by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for staff/admin user"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api_keys/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api_keys",
                "1"
              ]
            },
            "description": "Gets one API key by ID for the current tenant. Requires authenticated staff/admin user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has expected api key fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('business_id');",
                  "  pm.expect(json).to.have.property('name');",
                  "  pm.expect(json).to.have.property('scopes');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Api Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for admin user"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Warehouse Integration\",\n  \"expires_at\": \"2026-12-31T23:59:59Z\",\n  \"scopes\": [\"deliveries:write\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api_keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api_keys"
              ]
            },
            "description": "Creates an API key. Accepted body params: name, expires_at, scopes[]."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response includes newly issued plaintext key', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('plaintext_key');",
                  "  pm.expect(json.plaintext_key).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke Api Key",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for admin user"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api_keys/1/revoke",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api_keys",
                "1",
                "revoke"
              ]
            },
            "description": "Revokes an API key by setting revoked_at/revoked_by_user_id. No request body required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response shows revoked key', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('revoked_at');",
                  "  pm.expect(json.revoked_at).to.not.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rotate Api Key",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for admin user"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Warehouse Integration Rotated\",\n  \"expires_at\": \"2027-12-31T23:59:59Z\",\n  \"scopes\": [\"deliveries:write\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api_keys/1/rotate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api_keys",
                "1",
                "rotate"
              ]
            },
            "description": "Rotates an API key by revoking current key and creating a replacement. Body params are optional and match create params."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response includes replacement plaintext key', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('plaintext_key');",
                  "  pm.expect(json.plaintext_key).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Deliveries",
      "item": [
        {
          "name": "List Deliveries",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for non-create endpoints"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text",
                "disabled": true,
                "description": "Ignored on non-create endpoints; JWT auth is still used"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/deliveries?page=1&per_page=20&order_by=created_at&order_direction=desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "order_by",
                  "value": "created_at"
                },
                {
                  "key": "order_direction",
                  "value": "desc"
                },
                {
                  "key": "status",
                  "value": "awaiting_recipient",
                  "disabled": true
                },
                {
                  "key": "q[status_eq]",
                  "value": "awaiting_recipient",
                  "disabled": true
                }
              ]
            },
            "description": "Lists deliveries for the current tenant. Non-create endpoints continue to use JWT auth even if X-API-Key is present."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response is an array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(Array.isArray(json)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Delivery by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for non-create endpoints"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text",
                "disabled": true,
                "description": "Ignored on non-create endpoints; JWT auth is still used"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/deliveries/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries",
                "1"
              ]
            },
            "description": "Gets a delivery by ID for the current tenant. Non-create endpoints continue to use JWT auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has delivery fields', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('public_id');",
                  "  pm.expect(json).to.have.property('status');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Delivery",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text",
                "description": "API key auth path for delivery creation. Key must be active and include deliveries:write scope."
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "disabled": true,
                "description": "Optional JWT path (admin role). When X-API-Key is present, API-key auth path is evaluated first."
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Coffee shipment from Akaki warehouse\",\n  \"price\": 2450.0,\n  \"recipient_email\": \"operations@abebe-trading.et\",\n  \"pickup\": {\n    \"address1\": \"Akaki Kality Industrial Zone, Block C\",\n    \"address2\": \"Near Customs Gate 2\",\n    \"city\": \"Addis Ababa\",\n    \"region\": \"Addis Ababa\",\n    \"postal_code\": \"1000\",\n    \"country_code\": \"ET\",\n    \"latitude\": 8.839,\n    \"longitude\": 38.79,\n    \"contact_name\": \"Meseret Bekele\",\n    \"contact_phone\": \"+251911234567\",\n    \"instructions\": \"Call before arrival; loading dock closes at 6 PM\"\n  },\n  \"items\": [\n    {\n      \"name\": \"Grade 1 Coffee Beans\",\n      \"quantity\": 30\n    },\n    {\n      \"name\": \"Packaging Sacks\",\n      \"quantity\": 10\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/deliveries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries"
              ]
            },
            "description": "Creates a delivery. Body params match controller permit list exactly: description, price, recipient_email, pickup, items.\n\nAPI key auth examples for this endpoint:\n- 201 Created: active X-API-Key with deliveries:write scope\n- 401 Unauthorized: missing/invalid/revoked/expired X-API-Key on key-auth path\n- 403 Forbidden: active X-API-Key without deliveries:write scope\n\nSet collection variable createDeliveryExpectedStatus to 201, 401, or 403 before running the tests for the scenario you are validating."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expectedStatus = Number(pm.collectionVariables.get('createDeliveryExpectedStatus') || 201);",
                  "pm.test('Status code matches expected scenario', function () {",
                  "  pm.response.to.have.status(expectedStatus);",
                  "});",
                  "if (expectedStatus === 201) {",
                  "  pm.test('Success response has delivery payload', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('public_id');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('business_id');",
                  "    pm.expect(json).to.have.property('stops');",
                  "    pm.expect(json).to.have.property('items');",
                  "  });",
                  "}",
                  "if (expectedStatus === 401 || expectedStatus === 403) {",
                  "  pm.test('Auth failure response is empty or structured error', function () {",
                  "    const text = pm.response.text().trim();",
                  "    if (text.length === 0) {",
                  "      pm.expect(text).to.eql('');",
                  "      return;",
                  "    }",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('object');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel Delivery",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "description": "Required JWT for admin user"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text",
                "disabled": true,
                "description": "Ignored on non-create endpoints; JWT auth is still used"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Customer requested cancellation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/deliveries/1/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "deliveries",
                "1",
                "cancel"
              ]
            },
            "description": "Cancels a delivery. Requires JWT admin authorization."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
